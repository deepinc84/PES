# Server-only Trusted Engine connection. Never rename these with a NEXT_PUBLIC_ prefix.
TRUSTED_ENGINE_URL=https://trusted-engine.vercel.app
TRUSTED_ENGINE_API_KEY=replace-with-the-PES-client-api-key
TRUSTED_ENGINE_SITE_DOMAIN=pt-electrical.com

# Parked PES mode: skip Edge calls for native public routes.
# Set true when reactivating dynamic Core30 page replacement routing.
PES_ENGINE_FULL_ROUTING=false

# Change this value and redeploy to bust public Trusted Engine content caches.
PES_ENGINE_CACHE_REVISION=parked-2026-11-13-v1
